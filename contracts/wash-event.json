{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.smsystems.au/rfid/wash-event.schema.json",
  "title": "RFID wash event",
  "description": "An observable event in the decision and local command path.",
  "type": "object",
  "required": [
    "event_id",
    "correlation_id",
    "event_type",
    "occurred_at",
    "source",
    "sequence"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^demo-event-[a-z0-9-]{3,80}$"
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^demo-[a-z0-9-]{4,80}$"
    },
    "event_type": {
      "enum": [
        "tag_read",
        "decision_issued",
        "command_requested",
        "command_acknowledged",
        "command_rejected"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "enum": ["reader_edge", "access_api", "plc_bridge", "operator_dashboard"]
    },
    "outcome": {
      "type": ["string", "null"]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
